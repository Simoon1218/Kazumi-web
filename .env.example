# 可选：公网访问口令（留空表示免密访问，部署在公网 Render 强烈建议设置）
ACCESS_PASSWORD=

# 可选：会话 Cookie 签名密钥（留空启动时随机生成；Render render.yaml 会自动生成）
AUTH_SECRET=

# 可选：弹弹play 开放平台凭证（配置后可直接获取全网聚合弹幕）
DANDANAPI_APPID=
DANDANAPI_KEY=

# 可选：自定义弹幕 API 域名（默认 https://api.dandanplay.net，也可填写自建弹幕反代）
DANDAN_API_DOMAIN=https://api.dandanplay.net

# 可选：视频源解析代理（Render 海外节点通常无需配置，留空即可）
KAZUMI_PROXY=

# 是否启用按需无头浏览器嗅探（true/false，空闲后自动释放内存以适配 Render 512MB）
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_IDLE_SECONDS=45
RESOLVE_TIMEOUT_SECONDS=25

# 首次冷启动自动安装的初始规则：recommended | all | none | 逗号分隔规则名
AUTO_INSTALL_RULES=recommended

# 监听端口（Render 会自动注入 PORT 环境变量）
PORT=8333
